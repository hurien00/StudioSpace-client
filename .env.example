# ---------------------------------------------------------------------------
# StudioSpace frontend (Next.js) environment variables
# Copy to `.env` for local development and configure the same keys in Vercel.
# ---------------------------------------------------------------------------

# Public URL of this Next.js app. Must match the deployment URL exactly in
# production (for example https://studio-space.vercel.app) so Better Auth and
# Google OAuth build the correct callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# Long random string shared with the Express backend. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URL of the deployed Express API (no trailing slash).
# Inlined at build time, so set it before running `next build` / deploying.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional but recommended: ImgBB API key used by the "Upload photo from
# device" button on /add-studio. Get one free at https://api.imgbb.com/.
# Without it users can still paste a direct image URL.
NEXT_PUBLIC_IMGBB_API_KEY=

# Optional. Only needed if the auth handler is not served from this same origin.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
